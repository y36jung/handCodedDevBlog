{
  "$schema": "https://react.doctor/schema/config.json",
  // Perf tooling: only score shipped app code. Build output (built JS chunks), perf tooling scripts and tests are excluded.
  "ignore": {
    "files": [
      "perf-reports/**",
      ".next/**",
      ".lighthouseci/**",
      "scripts/**",
      "e2e/**",
      "test/**",
      "test-results/**",
      "**/*.test.*"
    ]
  }
}
